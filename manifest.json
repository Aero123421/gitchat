{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "gitchat",
  "description": "__MSG_extDescription__",
  "version": "0.1.4",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "gitchat",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.claudeusercontent.com/*",
        "https://*.scf.usercontent.goog/*",
        "https://*.web-sandbox.oaiusercontent.com/*"
      ],
      "js": [
        "frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
